{
  "expo": {
    "name": "Antriksh Typing Master",
    "slug": "antriksh-typing-master",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.antriksh.typingmaster"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Antriksh Typing Master",
      "shortName": "Typing Master",
      "description": "Professional Hindi Typing Software",
      "backgroundColor": "#0a0a0a",
      "themeColor": "#0d9488"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
